# Copy to .env to override docker-compose defaults.

# Deliver to webhook.site instead of the local mock provider.
# Create a URL at https://webhook.site, set its default response to status 202
# with body {"messageId":"...","status":"accepted","timestamp":"..."}.
# PROVIDER_URL=https://webhook.site/your-uuid

# Mock provider fault injection (fractions of requests)
MOCK_FAILURE_RATE=0.05
MOCK_THROTTLE_RATE=0.02
MOCK_REJECT_RATE=0
MOCK_LATENCY_MS=40

RATE_LIMIT_PER_SECOND=100
MAX_ATTEMPTS=5
LOG_LEVEL=info
